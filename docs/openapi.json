    "/api/v1/forms/{slug}/responses": {
      "post": {
        "summary": "Submit Response",
        "description": "Public endpoint: submit a response using the form's access code.\n\nKeyed on the form's slug (not the sequential DB id) so form ids are not\nenumerable; rate-limited per IP so access codes can't be brute-forced.",
        "operationId": "submit_response_api_v1_forms__slug__responses_post",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",

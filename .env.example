# Simple Forms — environment variables
# Copy this file to .env and fill in real values. .env is gitignored.

# SQLite database file path (default: forms.db)
SIMPLE_FORMS_DB=forms.db

# Public base URL of the app, used for full share links in the admin UI
# (e.g. http://192.168.1.10:8000). If unset, links are shown relative.
SIMPLE_FORMS_BASE_URL=

# Password for the NiceGUI admin UI at /admin. REQUIRED: the app refuses to
# start if this is unset or still the default 'admin'.
SIMPLE_FORMS_ADMIN_PASSWORD=change-me

# Stable master API key for the REST API (/api/v1).
# Generate one with:  python -c "import secrets; print('sfk_' + secrets.token_urlsafe(24))"
# If unset, a random key is generated per process; only its first 6 chars are
# logged at startup, so set this explicitly if you rely on the master key.
SIMPLE_FORMS_MASTER_API_KEY=

# Secret for NiceGUI browser storage (admin sessions). Set for stable login
# sessions across restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIMPLE_FORMS_STORAGE_SECRET=
